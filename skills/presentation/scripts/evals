#!/usr/bin/env python3
"""Run local, credential-free semantic presentation evaluation fixtures."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path


def evaluate(fixture: dict) -> list[str]:
    failures: list[str] = []
    titles = fixture.get("titles", [])
    if len(titles) != len(set(titles)):
        failures.append("duplicate-title")
    if fixture.get("missing_assets"):
        failures.append("missing-asset")
    if fixture.get("contrast", 4.5) < 4.5:
        failures.append("low-contrast")
    if fixture.get("overflow"):
        failures.append("overflow")
    return failures


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("fixture", type=Path)
    args = parser.parse_args()
    try:
        fixture = json.loads(args.fixture.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        print(f"invalid fixture: {exc}", file=sys.stderr)
        return 2
    print(json.dumps({"failures": evaluate(fixture)}, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
