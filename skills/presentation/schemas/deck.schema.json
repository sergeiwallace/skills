{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "deck", "renderer", "theme", "assets", "slides", "gates"],
  "properties": {
    "schema_version": {"const": 1},
    "deck": {"type": "object", "additionalProperties": false, "required": ["id", "title", "audience", "outcome", "duration_minutes", "delivery", "classification"], "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "audience": {"enum": ["internal", "external"]}, "outcome": {"type": "string", "minLength": 1}, "duration_minutes": {"type": "integer", "minimum": 1}, "delivery": {"type": "string", "minLength": 1}, "classification": {"enum": ["local-only", "approved-external"]}, "presenter": {"type": "string"}, "event_date": {"type": "string"}, "narrative_exception": {"type": "string", "minLength": 1}}},
    "renderer": {"type": "object", "additionalProperties": false, "required": ["name", "version", "ratio"], "properties": {"name": {"const": "slidev"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "ratio": {"enum": ["16:9", "4:3"]}}},
    "theme": {"type": "object", "additionalProperties": false, "required": ["root", "tokens"], "properties": {"root": {"enum": ["deck", "skill"]}, "tokens": {"type": "string", "minLength": 1}, "variant": {"type": "string"}}},
    "assets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "path", "kind", "alt", "source"], "properties": {"id": {"type": "string"}, "path": {"type": "string"}, "kind": {"type": "string"}, "alt": {"type": "string"}, "source": {"type": "string"}, "source_path": {"type": "string"}, "decorative": {"type": "boolean"}}}},
    "slides": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "order", "title", "intent", "layout", "regions", "evidence", "speaker_notes", "estimated_seconds"], "properties": {"id": {"type": "string"}, "order": {"type": "integer", "minimum": 1}, "title": {"type": "string"}, "intent": {"type": "string"}, "layout": {"type": "string"}, "regions": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}}, "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["claim", "source", "confidence"], "properties": {"claim": {"type": "string"}, "source": {"type": "string"}, "confidence": {"type": "string"}}}}, "speaker_notes": {"type": "string"}, "estimated_seconds": {"type": "integer", "minimum": 1}, "section": {"type": "string", "minLength": 1}, "time_cue": {"type": "string", "minLength": 1}}}},
    "gates": {"type": "object", "additionalProperties": false, "required": ["story-outline", "representative-visual-system", "final-rehearsal-export"], "properties": {"story-outline": {"type": "object", "additionalProperties": false, "properties": {}}, "representative-visual-system": {"type": "object", "additionalProperties": false, "properties": {}}, "final-rehearsal-export": {"type": "object", "additionalProperties": false, "properties": {}}}}
  }
}
