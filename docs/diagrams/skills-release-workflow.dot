digraph skills_release_workflow {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    pad="0.22",
    nodesep="0.38",
    ranksep="0.25",
    fontname="DejaVu Sans"
  ];
  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#eff6ff",
    color="#64748b",
    fontcolor="#0f172a",
    fontname="DejaVu Sans",
    fontsize=14,
    penwidth=1.2,
    margin="0.16,0.11"
  ];
  edge [
    color="#64748b",
    fontcolor="#334155",
    fontname="DejaVu Sans",
    fontsize=11,
    arrowsize=0.7,
    penwidth=1.2
  ];

  inventory [label="Internal skills\nand tooling"];
  portable [label="Portable configuration\nand dependencies"];
  review [
    label="Privacy, license\nand safety review",
    shape=diamond,
    style=filled,
    fillcolor="#fff7ed",
    color="#c27828",
    margin="0.10,0.05"
  ];
  revise [label="Refactor and\nre-evaluate", fillcolor="#f8fafc"];
  cli [label="CLI skills, plugins\nand shared libraries"];
  adapters [label="MCP modules and\nhost adapters"];
  validate [label="Validate each host\nand dependency set"];
  publish [
    label="Publish approved artifacts\nand verified listings",
    fillcolor="#ecfdf5",
    color="#23856a"
  ];

  inventory -> portable;
  portable -> review;
  review -> revise [label="Needs work"];
  revise -> portable [constraint=false];
  review -> cli [label="Approved"];
  review -> adapters [label="Approved"];
  cli -> validate;
  adapters -> validate;
  validate -> publish;
  { rank=same; review; revise; }
  { rank=same; cli; adapters; }
}
